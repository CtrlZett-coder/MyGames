# Скопируй этот файл в .env (рядом с bot.py) и впиши свои данные.
# Файл .env НЕ попадает в git — так ключи не утекут на GitHub.

TELEGRAM_BOT_TOKEN=вставь_токен_от_BotFather
ANTHROPIC_API_KEY=вставь_ключ_с_platform.claude.com

# Твой Telegram ID (узнай командой /myid). Несколько — через запятую.
ALLOWED_USERS=

# Необязательно:
# LOW_BALANCE_RUB=50
# USD_RUB=100
# PROVIDER=claude
# DEEPSEEK_API_KEY=
